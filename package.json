{
  "name": "@fishbrain/eslint-config-monorepo",
  "private": true,
  "description": "ESLint configs for Fishbrain projects",
  "version": "6.3.7",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fishbrain/eslint-config-fishbrain.git"
  },
  "author": "Fishbrain",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/fishbrain/eslint-config-fishbrain/issues"
  },
  "homepage": "https://github.com/fishbrain/eslint-config-fishbrain#readme",
  "scripts": {
    "test": "yarn workspaces foreach --all run test"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all"
  },
  "resolutions": {
    "minimatch": "10.2.6"
  },
  "resolutionComments": {
    "minimatch": "This is needed due to eslint-plugin-jsx-a11y lagging in updating. Minimatch contains a vulnerability in the brace-expansion lib. This override should be very temporary as minimatch is used widely and leaving it pinned will eventually break something else."
  },
  "packageManager": "yarn@4.18.0"
}
